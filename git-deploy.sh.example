SYSTEMD_SERVICE="your-service-name"
USER_OWNER="www-data"

# === Цвета для вывода ===
GREEN='\033[32m'
BLUE='\033[34m'
YELLOW='\033[33m'
RED='\033[31m'
NC='\033[0m' # No Color

